    { "id": "pel-03", "topic": "peluang", "level": "XI", "q": "Sebuah kantong berisi 3 kelereng merah dan 2 biru. Peluang mengambil merah adalah ...", "options": ["2/5", "3/5", "3/2", "1/2"], "answer": 1, "explain": "3 merah dari total 5 kelereng: 3/5.", "diff": "mudah" },

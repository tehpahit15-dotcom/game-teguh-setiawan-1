    { "id": "pel-05", "topic": "peluang", "level": "XII", "q": "Banyak cara memilih 2 orang dari 5 orang adalah ...", "options": ["5", "10", "15", "20"], "answer": 1, "explain": "Kombinasi C(5,2) = 5!/(2!3!) = 10.", "diff": "sedang" },

  "questions": [
    { "id": "alg-01", "topic": "aljabar", "level": "X", "q": "Jika 2x + 6 = 14, maka nilai x adalah ...", "options": ["2", "3", "4", "5"], "answer": 2, "explain": "2x = 14 − 6 = 8, jadi x = 8 ÷ 2 = 4.", "diff": "mudah" },
    { "id": "alg-02", "topic": "aljabar", "level": "X", "q": "Akar-akar persamaan x² − 5x + 6 = 0 adalah ...", "options": ["1 dan 6", "2 dan 3", "−2 dan −3", "−1 dan −6"], "answer": 1, "explain": "Faktorisasi: (x − 2)(x − 3) = 0, jadi x = 2 atau x = 3.", "diff": "mudah" },
    { "id": "alg-03", "topic": "aljabar", "level": "X", "q": "Hasil dari (3x − 2)(x + 4) adalah ...", "options": ["3x² + 10x − 8", "3x² + 14x − 8", "3x² − 10x − 8", "3x² + 10x + 8"], "answer": 0, "explain": "3x·x = 3x²; 3x·4 = 12x; −2·x = −2x; −2·4 = −8. Total: 3x² + 10x − 8.", "diff": "sedang" },
    { "id": "alg-04", "topic": "aljabar", "level": "XI", "q": "Himpunan penyelesaian 2x² − 7x + 3 = 0 adalah ...", "options": ["{1/3, 3}", "{−1/3, −3}", "{1, 3}", "{3, 6}"], "answer": 0, "explain": "Faktorisasi: (2x − 1)(x − 3) = 0 → x = 1/3 atau x = 3.", "diff": "sedang" },
    { "id": "alg-05", "topic": "aljabar", "level": "XI", "q": "Jika f(x) = 3x + 5, maka f(4) = ...", "options": ["12", "15", "17", "20"], "answer": 2, "explain": "f(4) = 3(4) + 5 = 12 + 5 = 17.", "diff": "mudah" },
    { "id": "alg-06", "topic": "aljabar", "level": "XI", "q": "Sistem: x + y = 7 dan x − y = 3. Nilai x adalah ...", "options": ["2", "4", "5", "6"], "answer": 2, "explain": "Jumlahkan kedua persamaan: 2x = 10 → x = 5.", "diff": "sedang" },
    { "id": "alg-07", "topic": "aljabar", "level": "XII", "q": "Nilai maksimum fungsi f(x) = −x² + 6x − 5 adalah ...", "options": ["3", "4", "5", "9"], "answer": 1, "explain": "Sumbu simetri x = −b/2a = 3. f(3) = −9 + 18 − 5 = 4.", "diff": "sedang" },
    { "id": "alg-08", "topic": "aljabar", "level": "X", "q": "Bentuk sederhana dari 4x²y − 6xy² + 2xy adalah ...", "options": ["2xy(2x − 3y + 1)", "2xy(2x − 3y)", "xy(4x − 6y + 2)", "2x(2xy − 3y + 1)"], "answer": 0, "explain": "Faktor bersama terbesarnya 2xy. Bagi tiap suku: 2x − 3y + 1.", "diff": "sedang" },
    { "id": "alg-09", "topic": "aljabar", "level": "XII", "q": "Jika 2ˣ = 32, maka x = ...", "options": ["4", "5", "6", "16"], "answer": 1, "explain": "32 = 2⁵, jadi x = 5.", "diff": "mudah" },
    { "id": "alg-10", "topic": "aljabar", "level": "XI", "q": "Barisan aritmetika: 3, 7, 11, 15, ... Suku ke-10 adalah ...", "options": ["36", "39", "42", "45"], "answer": 1, "explain": "a = 3, b = 4. Un = a + (n−1)b = 3 + 9×4 = 39.", "diff": "sedang" },
    { "id": "geo-01", "topic": "geometri", "level": "X", "q": "Sebuah segitiga siku-siku dengan sisi 6 cm dan 8 cm. Sisi miringnya adalah ...", "options": ["10 cm", "12 cm", "14 cm", "100 cm"], "answer": 0, "explain": "Pythagoras: √(6² + 8²) = √(36 + 64) = √100 = 10 cm.", "diff": "mudah" },
    { "id": "geo-02", "topic": "geometri", "level": "X", "q": "Luas lingkaran dengan jari-jari 7 cm (π = 22/7) adalah ...", "options": ["44 cm²", "88 cm²", "154 cm²", "308 cm²"], "answer": 2, "explain": "L = πr² = (22/7) × 49 = 22 × 7 = 154 cm².", "diff": "mudah" },
    { "id": "geo-03", "topic": "geometri", "level": "X", "q": "Keliling persegi dengan sisi 9 cm adalah ...", "options": ["18 cm", "27 cm", "36 cm", "81 cm"], "answer": 2, "explain": "K = 4 × s = 4 × 9 = 36 cm.", "diff": "mudah" },
    { "id": "geo-04", "topic": "geometri", "level": "XI", "q": "Volume kubus dengan rusuk 5 cm adalah ...", "options": ["25 cm³", "50 cm³", "75 cm³", "125 cm³"], "answer": 3, "explain": "V = s³ = 5³ = 125 cm³.", "diff": "mudah" },
    { "id": "geo-05", "topic": "geometri", "level": "XI", "q": "Luas segitiga dengan alas 10 cm dan tinggi 6 cm adalah ...", "options": ["16 cm²", "30 cm²", "60 cm²", "120 cm²"], "answer": 1, "explain": "L = ½ × a × t = ½ × 10 × 6 = 30 cm².", "diff": "mudah" },
    { "id": "geo-06", "topic": "geometri", "level": "XII", "q": "Volume kerucut dengan r = 7 cm, t = 24 cm (π = 22/7) adalah ...", "options": ["1.232 cm³", "1.848 cm³", "3.696 cm³", "5.544 cm³"], "answer": 0, "explain": "V = ⅓πr²t = ⅓ × (22/7) × 49 × 24 = 1.232 cm³.", "diff": "sedang" },
    { "id": "geo-07", "topic": "geometri", "level": "X", "q": "Jumlah sudut dalam segitiga adalah ...", "options": ["90°", "180°", "270°", "360°"], "answer": 1, "explain": "Jumlah sudut dalam segitiga selalu 180°.", "diff": "mudah" },
    { "id": "geo-08", "topic": "geometri", "level": "XI", "q": "Diagonal sisi kubus dengan rusuk 4 cm adalah ...", "options": ["4√2 cm", "4√3 cm", "8 cm", "16 cm"], "answer": 0, "explain": "Diagonal sisi = s√2 = 4√2 cm.", "diff": "sedang" },
    { "id": "tri-01", "topic": "trigonometri", "level": "X", "q": "Nilai sin 30° adalah ...", "options": ["1/2", "√2/2", "√3/2", "1"], "answer": 0, "explain": "Sudut istimewa: sin 30° = 1/2.", "diff": "mudah" },
    { "id": "tri-02", "topic": "trigonometri", "level": "X", "q": "Nilai cos 60° adalah ...", "options": ["1/2", "√2/2", "√3/2", "0"], "answer": 0, "explain": "Sudut istimewa: cos 60° = 1/2.", "diff": "mudah" },
    { "id": "tri-03", "topic": "trigonometri", "level": "XI", "q": "Nilai tan 45° adalah ...", "options": ["0", "1/2", "1", "√3"], "answer": 2, "explain": "tan 45° = sin 45° / cos 45° = 1.", "diff": "mudah" },
    { "id": "tri-04", "topic": "trigonometri", "level": "XI", "q": "Pada segitiga siku-siku, sin A = sisi di depan / ...", "options": ["sisi di depan", "sisi di samping", "sisi miring (hipotenusa)", "keliling"], "answer": 2, "explain": "Sin = depan / miring. Cos = samping / miring. Tan = depan / samping.", "diff": "mudah" },
    { "id": "tri-05", "topic": "trigonometri", "level": "XI", "q": "Nilai sin 90° adalah ...", "options": ["0", "1/2", "√2/2", "1"], "answer": 3, "explain": "sin 90° = 1 (titik tertinggi pada grafik sinus).", "diff": "mudah" },
    { "id": "tri-06", "topic": "trigonometri", "level": "XI", "q": "Jika sin θ = 3/5 dan θ sudut lancip, maka cos θ = ...", "options": ["3/5", "4/5", "5/3", "4/3"], "answer": 1, "explain": "sin² + cos² = 1 → cos² = 1 − 9/25 = 16/25 → cos θ = 4/5 (lancip, positif).", "diff": "sedang" },
    { "id": "stat-01", "topic": "statistika", "level": "X", "q": "Rata-rata dari data 4, 6, 8, 10, 12 adalah ...", "options": ["7", "8", "9", "10"], "answer": 1, "explain": "Jumlah = 40, banyak data = 5. Rata-rata = 40 ÷ 5 = 8.", "diff": "mudah" },
    { "id": "stat-02", "topic": "statistika", "level": "X", "q": "Median dari data 3, 5, 7, 9, 11 adalah ...", "options": ["5", "7", "9", "11"], "answer": 1, "explain": "Data terurut, nilai tengah (ke-3) adalah 7.", "diff": "mudah" },
    { "id": "stat-03", "topic": "statistika", "level": "X", "q": "Modus dari data 2, 4, 4, 6, 8, 4 adalah ...", "options": ["2", "4", "6", "8"], "answer": 1, "explain": "Nilai yang paling sering muncul adalah 4 (tiga kali).", "diff": "mudah" },
    { "id": "stat-04", "topic": "statistika", "level": "XI", "q": "Rata-rata dari 5, 7, 9, 11, 13 adalah ...", "options": ["8", "9", "10", "11"], "answer": 1, "explain": "Jumlah = 45, n = 5 → 45 ÷ 5 = 9.", "diff": "mudah" },
    { "id": "stat-05", "topic": "statistika", "level": "XI", "q": "Median dari data genap 2, 4, 6, 8 adalah ...", "options": ["4", "5", "6", "7"], "answer": 1, "explain": "Median = rata-rata dua nilai tengah: (4 + 6) ÷ 2 = 5.", "diff": "sedang" },
    { "id": "stat-06", "topic": "statistika", "level": "XII", "q": "Jika rata-rata 4 bilangan adalah 10 dan tiga di antaranya 8, 12, 14, maka bilangan keempat adalah ...", "options": ["6", "8", "10", "12"], "answer": 0, "explain": "Jumlah total = 4 × 10 = 40. Yang diketahui = 34. Sisa = 40 − 34 = 6.", "diff": "sedang" },
    { "id": "stat-07", "topic": "statistika", "level": "X", "q": "Jangkauan (range) dari data 5, 9, 3, 12, 7 adalah ...", "options": ["7", "9", "12", "15"], "answer": 1, "explain": "Range = nilai terbesar − terkecil = 12 − 3 = 9.", "diff": "mudah" },
